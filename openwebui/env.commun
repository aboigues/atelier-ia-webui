# Variables non secrètes d'Open WebUI v0.13.5 (contracts/configuration-openwebui.md ; noms vérifiés
# dans backend/open_webui/env.py et config.py au tag, research.md R2 et R13). Les secrets (clé
# Scaleway, secret de session, compte formateur) sont passés par l'environnement, jamais ici.

WEBUI_NAME=Atelier IA - Telemach Learning
DEFAULT_LOCALE=fr-FR
# La configuration est décrite en code : rien n'est figé en base par l'interface.
ENABLE_PERSISTENT_CONFIG=false

# Comptes : seuls ceux créés par le formateur (FR-007).
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false

# Un seul fournisseur : Scaleway Generative APIs, région Paris (FR-002).
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
DEFAULT_MODELS=assistant-bureau-etudes
TASK_MODEL_EXTERNAL=mistral-small-3.2-24b-instruct-2506

# Documents envoyés en entier, sans base vectorielle ni modèle local (research.md R2).
BYPASS_EMBEDDING_AND_RETRIEVAL=true
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=bge-multilingual-gemma2
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_FILE_MAX_SIZE=200
# Dépôt limité aux formats de l'atelier (FR-003) : ferme l'accès à ffmpeg, libtiff, libxml2 et
# unstructured (exceptions de sécurité, research.md R13).
RAG_ALLOWED_FILE_EXTENSIONS=png,jpg,jpeg,pdf,txt,csv,ifc

# Aucune donnée vers un tiers (FR-012).
OFFLINE_MODE=true
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_OTEL=false
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false

# Fonctions hors périmètre de l'atelier.
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
USER_PERMISSIONS_CHAT_STT=false
USER_PERMISSIONS_CHAT_TTS=false
USER_PERMISSIONS_CHAT_CALL=false

# Bibliothèque de consignes (FR-009).
USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS=true
